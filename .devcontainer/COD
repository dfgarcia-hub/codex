<script>
(function() {

// --- VARIABLES GLOBALES DE ESTADO ---
let signaturePad = null;
let currentPath = ''; // Guarda el camino (YP, YA, YM)
let isDescarteTaller = false;
let fotoPlacaBase64 = null; // <-- AGREGA ESTA LÍNEA
let fotoPlacaMimeType = null; // <-- AGREGA ESTA LÍNEA

// --- Variables de Guardado Automático ---
const LOCAL_STORAGE_KEY = 'formDataBackup';
const statusEl = document.getElementById('save-status');

// --- Función Debounce ---
function debounce(func, wait) {
let timeout;
return function(...args) {
const context = this;
clearTimeout(timeout);
timeout = setTimeout(() => func.apply(context, args), wait);
};
}

// --- Funciones de Estado de Guardado ---
function updateSaveStatus(message) {
if (!statusEl) return;
statusEl.textContent = message;
statusEl.style.display = 'block';
setTimeout(() => statusEl.classList.add('visible'), 10);
}

function hideSaveStatus(delay = 1500) {
if (!statusEl) return;
setTimeout(() => {
statusEl.classList.remove('visible');
setTimeout(() => {
if (!statusEl.classList.contains('visible')) {
statusEl.style.display = 'none';
}
}, 500);
}, delay);
}

// --- MEJORA: Función para Guardar en localStorage ---
function saveToLocalStorage() {
const container = document.getElementById('form-container');
if (!container) return;

updateSaveStatus('Guardando...');

const dataToSave = {};
// Guardar inputs, selects, textareas (AHORA INCLUYE READONLY)
container.querySelectorAll('input, select, textarea').forEach(el => {
// Solo guardar si tiene ID (ya no filtramos por readOnly)
if (el.id) {
if (el.type === 'checkbox') {
dataToSave[el.id] = el.checked;
} else if (el.type === 'file') {
// No podemos guardar archivos
} else {
dataToSave[el.id] = el.value;
}
}
});

// MEJORA: Guardar específicamente las cantidades de inventario (ya que no tienen ID)
const inventoryQuantities = [];
container.querySelectorAll('#inventory-table .cantidad-producto').forEach((input, index) => {
// Usamos el índice como identificador único para esta sesión
inventoryQuantities.push({ index: index, value: input.value });
});
dataToSave['inventoryQuantities'] = inventoryQuantities;


// Guardar firma
if (signaturePad && !signaturePad.isEmpty()) {
dataToSave['signaturePadData'] = signaturePad.toDataURL();
}

// CORREGIDO: Guardar foto independientemente de la firma
dataToSave['fotoPlacaBase64'] = fotoPlacaBase64;
dataToSave['fotoPlacaMimeType'] = fotoPlacaMimeType;


try {
localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(dataToSave));
updateSaveStatus('Guardado sin conexión');
hideSaveStatus();
} catch (e) {
console.error('Error al guardar en localStorage:', e);
updateSaveStatus('Error al guardar');
hideSaveStatus(3000);
}
}

const debouncedSave = debounce(saveToLocalStorage, 1000);

// --- MEJORA: Función para Cargar de localStorage ---
function loadFromLocalStorage() {
    const container = document.getElementById('form-container');
    if (!container) return;

    try {
        const savedData = localStorage.getItem(LOCAL_STORAGE_KEY);
        if (!savedData) {
            console.log('No hay datos locales para cargar.');
            return;
        }

        const data = JSON.parse(savedData);
        let hasRestoredData = false;

        // Restaurar todos los campos con ID
        Object.keys(data).forEach(key => { // <--- El forEach empieza aquí
            const el = container.querySelector('#' + key);
            if (el) {
                if (el.type === 'checkbox') {
                    el.checked = data[key];
                } else if (el.type !== 'file') {
                    el.value = data[key];
                }
                hasRestoredData = true;
            }
        }); // <--- ¡¡AQUÍ ESTABA EL ERROR DE SINTAXIS!!

        // Restaurar foto (si existe)
        if (data['fotoPlacaBase64']) {
            fotoPlacaBase64 = data['fotoPlacaBase64'];
        }
        if (data['fotoPlacaMimeType']) {
            fotoPlacaMimeType = data['fotoPlacaMimeType'];
        }

        // MEJORA: Restaurar cantidades de inventario
        // (¡EL BLOQUE ROTO Y DUPLICADO SE HA ELIMINADO!)
        if (data['inventoryQuantities']) {
            const allQtyInputs = container.querySelectorAll('#inventory-table .cantidad-producto');
            data['inventoryQuantities'].forEach(item => {
                if (allQtyInputs[item.index]) {
                    allQtyInputs[item.index].value = item.value;
                }
            });
            // Recalcular totales si restauramos inventario
            setTimeout(calcularTotalesInventario, 100);
            hasRestoredData = true;
        }


        if (hasRestoredData) {
            console.log('Datos restaurados desde localStorage.');
            updateSaveStatus('Progreso restaurado');
            hideSaveStatus();
        }

    } catch (e) {
        console.error('Error al cargar desde localStorage (borrando datos corruptos):', e);
        localStorage.removeItem(LOCAL_STORAGE_KEY);
    }
}

// --- FUNCIÓN PRINCIPAL DE RENDERIZADO (MODIFICADA) ---
function renderTemplate() {
const tpl = document.getElementById('form-template').innerHTML;
const container = document.getElementById('form-container');
container.innerHTML = tpl;

currentPath = '';
isDescarteTaller = false;
signaturePad = null;

window.removeEventListener("resize", resizeCanvas);

attachHandlers();
calcularTotalesInventario();

// Cargar datos DESPUÉS de adjuntar handlers y ANTES de mostrar la sección 1
loadFromLocalStorage();

show('seccion1');
}

// --- FUNCIÓN DE NAVEGACIÓN (MODIFICADA) ---
function show(id) {
const container = document.getElementById('form-container');
if (!container) return;

container.querySelectorAll('.card').forEach(el => { if (el) el.classList.add('hidden'); });

const el = container.querySelector('#' + id);
if (el) {
el.classList.remove('hidden');
window.scrollTo(0, 0); // Regresar al inicio de la página al cambiar de sección

if (id === 'seccion17-firma') {
const canvas = container.querySelector('#signature-pad');
if (canvas) {
if (!signaturePad) { initializeSignaturePad(canvas); }
resizeCanvas();

// Restaurar firma
try {
const savedData = localStorage.getItem(LOCAL_STORAGE_KEY);
if (savedData) {
const data = JSON.parse(savedData);
if (data['signaturePadData'] && signaturePad && signaturePad.isEmpty()) {
signaturePad.fromDataURL(data['signaturePadData']);
console.log('Firma restaurada desde localStorage.');
}
}
} catch(e) { console.error('Error al restaurar firma:', e); }
}
}
} else {
console.warn(`Se intentó mostrar sección inexistente: #${id}`);
}
}

// --- FUNCIONES DE UTILIDAD (Firma) (MODIFICADA) ---
function initializeSignaturePad(canvasElement) {
if (!canvasElement || signaturePad) return;
try {
signaturePad = new SignaturePad(canvasElement, {
backgroundColor: 'rgb(255, 255, 255)',
penColor: 'rgb(0, 0, 0)',
minWidth: 2.0,
maxWidth: 3.0
});
window.addEventListener("resize", resizeCanvas);

// Guardar al terminar de firmar
signaturePad.addEventListener("endStroke", () => {
console.log('Firma actualizada, guardando...');
debouncedSave();
});

console.log("SignaturePad inicializado.");
} catch(e){
console.error("Error inicializando SignaturePad:", e);
signaturePad = null;
}
}

function resizeCanvas() {
const container = document.getElementById('form-container');
const canvas = container ? container.querySelector('#signature-pad') : null;
if (!canvas || !signaturePad) return;

const signatureSection = container.querySelector('#seccion17-firma');
if (signatureSection && !signatureSection.classList.contains('hidden')) {
if (canvas.offsetWidth > 0 && canvas.offsetHeight > 0) {
const ratio = Math.max(window.devicePixelRatio || 1, 1);
const data = signaturePad.toData();

canvas.width = canvas.offsetWidth * ratio;
canvas.height = canvas.offsetHeight * ratio;

const ctx = canvas.getContext("2d");
if (ctx) {
ctx.scale(ratio, ratio);
signaturePad.fromData(data);
} else {
console.error("No se pudo obtener el contexto 2D.");
}
}
}
}

// --- FUNCIÓN PARA FORMATEAR MONEDA RD$ ---
function formatCurrencyRD(number) {
if (isNaN(number) || number === null) {
return 'RD$ 0.00';
}
const formatter = new Intl.NumberFormat('es-DO', {
style: 'currency',
currency: 'DOP',
minimumFractionDigits: 2,
maximumFractionDigits: 2
});
return formatter.format(number);
}

// --- FUNCIONES DE UTILIDAD (Formulario) ---
function clearAllFields(container) {
if (!container) return;

container.querySelectorAll('input, select, textarea').forEach(el => {
if (el.type === 'file') {
el.value = ''; // Limpiar input de archivo
return;
}
if (el.classList.contains('time-input')) { el.value = ''; }
// Limpiar todo lo que NO sea readonly O un subtotal
else if (!el.readOnly || el.classList.contains('subtotal-producto')) {
if (!el.classList.contains('cantidad-producto')) {
el.value = '';
}
}

if (el.tagName.toLowerCase() === 'select') el.selectedIndex = 0;

if (el.id === 'detalleFreezer') { Array.from(el.options).forEach(opt => opt.disabled = false); }
if (el.id === 'estadoReposicion') {
const btnEstado = container.querySelector('#btnContinuar_estado');
if (btnEstado) btnEstado.textContent = 'Siguiente ➡️';
}
if (el.classList.contains('cantidad-producto')) { el.value = ''; } // Limpiar cantidades
if (el.classList.contains('subtotal-producto')) {
el.value = formatCurrencyRD(0);
el.dataset.value = '0.00';
}
});

// Limpiar campos readonly que se llenan con la búsqueda
['#nombreEstablecimiento','#telefono','#vendedor','#supervisor'].forEach(id => {
const el = container.querySelector(id); if(el) el.value='';
});

container.querySelectorAll('.inventory-row').forEach(row => { row.classList.remove('focused', 'filled'); });

const resumenContenido = container.querySelector('#resumen_inventario_contenido pre');
if(resumenContenido) resumenContenido.textContent = '';

calcularTotalesInventario();
if (signaturePad) { signaturePad.clear(); }
}

// --- FUNCIÓN calcularTotalesInventario ---
function calcularTotalesInventario() {
const container = document.getElementById('form-container');
if (!container) return;

// Primero, recalcular todos los subtotales basado en las cantidades
container.querySelectorAll('#inventory-table .cantidad-producto').forEach(cInput => {
const cant = parseFloat(cInput.value) || 0;
const row = cInput.closest('.inventory-row');
if (!row) return;
const cCell = row.querySelector('.inventory-cell[data-costo]');
if (!cCell) return;
const cUnit = parseFloat(cCell.getAttribute('data-costo')) || 0;
const subInput = row.querySelector('.subtotal-producto');
if (!subInput) return;

const subtotalNumerico = cant * cUnit;
subInput.value = formatCurrencyRD(subtotalNumerico); // Muestra formateado
subInput.dataset.value = subtotalNumerico.toFixed(2); // Guarda número interno

if (cant > 0) { row.classList.add('filled'); }
else { row.classList.remove('filled'); }
});

// Ahora, sumar todos los subtotales
const subTotalElements = container.querySelectorAll('.subtotal-producto');
let grandSubTotalCalc = 0;

subTotalElements.forEach(input => {
const value = parseFloat(input.dataset.value || 0);
grandSubTotalCalc += value;
});

const itbis = grandSubTotalCalc * 0.18;
const grandTotal = grandSubTotalCalc + itbis;

const grandSubTotalElement = container.querySelector('#grandSubTotal');
const itbisElement = container.querySelector('#itbisAmount');
const grandTotalElement = container.querySelector('#grandTotalAmount');

if (grandSubTotalElement) grandSubTotalElement.textContent = formatCurrencyRD(grandSubTotalCalc);
if (itbisElement) itbisElement.textContent = formatCurrencyRD(itbis);
if (grandTotalElement) grandTotalElement.textContent = formatCurrencyRD(grandTotal);
}

// --- FUNCIONES PARA RECOPILAR Y GUARDAR DATOS ---
function recopilarDatosFormulario() {
const container = document.getElementById('form-container');
