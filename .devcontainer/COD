// --- FUNCIÓN DE MANEJADORES (ATTACH HANDLERS) ---
function attachHandlers() {
    const container = document.getElementById('form-container');
    if (!container) { console.error("El contenedor #form-container no existe."); return; }

    // (Selección de elementos)
    const tecnico = container.querySelector('#tecnico');
    const btnContinuar1 = container.querySelector('#btnContinuar1');
    const ubicacion = container.querySelector('#ubicacion');
    const zona = container.querySelector('#zona');
    const codigoCliente = container.querySelector('#codigoCliente');
    const btnBuscarCliente = container.querySelector('#btnBuscarCliente');
    const placaFreezer = container.querySelector('#placaFreezer');
    const modelo = container.querySelector('#modelo');
    const tipoMantenimiento = container.querySelector('#tipoMantenimiento');
    const detalleAlistamiento = container.querySelector('#detalleAlistamiento');
    const detalleFreezer = container.querySelector('#detalleFreezer');
    const estadoReposicion = container.querySelector('#estadoReposicion');
    const btnContinuarEstado = container.querySelector('#btnContinuar_estado');
    const btnClearSignature = container.querySelector('#btnClearSignature');
    const fotoPlacaInput = container.querySelector('#fotoPlaca'); // <-- LÍNEA CORRECTA

    // (Lógica de Buscadores)
    const searchRepFuncional = container.querySelector('#searchRepFuncional');
    const itemsRepFuncional = container.querySelectorAll('#seccion12-rep-funcional .repuesto-item');
    if (searchRepFuncional && itemsRepFuncional.length > 0) {
        searchRepFuncional.addEventListener('input', (e) => {
            const st = e.target.value.toLowerCase().trim();
            itemsRepFuncional.forEach(item => {
                const l = item.querySelector('label');
                if (l) { const it = l.textContent.toLowerCase(); item.style.display = it.includes(st) ? 'flex' : 'none'; }
            });
        });
    }
    const searchRepNoFuncional = container.querySelector('#searchRepNoFuncional');
    const itemsRepNoFuncional = container.querySelectorAll('#seccion13-rep-nofuncional .repuesto-item');
    if (searchRepNoFuncional && itemsRepNoFuncional.length > 0) {
        searchRepNoFuncional.addEventListener('input', (e) => {
            const st = e.target.value.toLowerCase().trim();
            itemsRepNoFuncional.forEach(item => {
                const l = item.querySelector('label');
                if (l) { const it = l.textContent.toLowerCase(); item.style.display = it.includes(st) ? 'flex' : 'none'; }
            });
        });
    }
    const searchInventory = container.querySelector('#searchInventory');
    const inventoryRows = container.querySelectorAll('#inventory-table .inventory-row');
    if (searchInventory && inventoryRows.length > 0) {
        searchInventory.addEventListener('input', (e) => {
            const st = e.target.value.toLowerCase().trim();
            inventoryRows.forEach(row => {
                const productCell = row.querySelector('.inventory-cell[data-label="PRODUCTO"]');
                let isVisible = false;
                if (productCell && productCell.textContent.toLowerCase().includes(st)) {
                    isVisible = true;
                }
                
                // Aplicar 'display: contents' (para grid) o 'none' a la fila
                const cells = row.querySelectorAll('.inventory-cell');
                cells.forEach(c => {
                    c.style.display = isVisible ? '' : 'none'; 
                });
            });
        });
    }

    // --- ¡¡ARREGLADO!! ---
    // (Este bloque va aquí afuera, no dentro del buscador de inventario)
    // (NUEVO: Lógica de captura de foto)
    if (fotoPlacaInput) {
        fotoPlacaInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) {
                fotoPlacaBase64 = null;
                fotoPlacaMimeType = null;
                return;
            }
            updateSaveStatus('Procesando foto...');
            const reader = new FileReader();
            reader.onloadend = () => {
                const fullDataUrl = reader.result;
                const parts = fullDataUrl.split(',');
                fotoPlacaMimeType = parts[0].split(':')[1].split(';')[0];
                fotoPlacaBase64 = parts[1];
                console.log('Foto capturada y convertida.');
                debouncedSave(); 
                hideSaveStatus();
            };
            reader.onerror = () => {
                console.error('Error al leer el archivo de imagen.');
                alert('Hubo un error al procesar la foto.');
                fotoPlacaBase64 = null;
                fotoPlacaMimeType = null;
                hideSaveStatus(0);
            };
            reader.readAsDataURL(file);
        });
    }
    // --- FIN DEL ARREGLO ---


    // (Lógica de Firma)
    if (btnClearSignature) {
        btnClearSignature.addEventListener('click', () => {
            if (signaturePad) signaturePad.clear();
            debouncedSave();
        });
    }

    // (Lógica de Navegación)
    if (btnContinuar1 && tecnico) {
        btnContinuar1.addEventListener('click', function() {
            const t = tecnico.value;
            if (!t) { alert('Seleccione un técnico.'); return; }
            if (t === 'JUAN CARLOS ZAPATA') { show('seccion2-moto'); }
            else { show('seccion3-ubicacion'); }
        });
    }
    const btnAtrasMoto = container.querySelector('#btnAtras_moto');
    if (btnAtrasMoto) btnAtrasMoto.addEventListener('click', () => show('seccion1'));
    const btnContinuarMoto = container.querySelector('#btnContinuar_moto');
    if (btnContinuarMoto) btnContinuarMoto.addEventListener('click', () => show('seccion3-ubicacion'));
    const btnAtrasUbic = container.querySelector('#btnAtras_ubic');
    if (btnAtrasUbic) btnAtrasUbic.addEventListener('click', () => show('seccion1'));
    const btnContinuarUbic = container.querySelector('#btnContinuar_ubic');
    if (btnContinuarUbic && ubicacion) btnContinuarUbic.addEventListener('click', () => {
        const u = ubicacion.value;
        if (!u) { alert('Seleccione ubicación.'); return; }
        if (u === 'CLIENTE') show('seccion4-zona');
        else if (u === 'TALLER') {
            show('seccion6-equipo');
        }
    });
    const btnAtrasZona = container.querySelector('#btnAtras_zona');
    if (btnAtrasZona) btnAtrasZona.addEventListener('click', () => show('seccion3-ubicacion'));
    const btnContinuarZona = container.querySelector('#btnContinuar_zona');
    if (btnContinuarZona && zona) btnContinuarZona.addEventListener('click', () => {
        if (!zona.value) { alert('Seleccione zona.'); return; } show('seccion5-cliente');
    });
    const btnAtrasCliente = container.querySelector('#btnAtras_cliente');
    if (btnAtrasCliente) btnAtrasCliente.addEventListener('click', () => {
        show('seccion4-zona');
    });
    const btnContinuarCliente = container.querySelector('#btnContinuar_cliente');
    if (btnContinuarCliente) btnContinuarCliente.addEventListener('click', () => show('seccion6-equipo'));
    const btnAtrasEquipo = container.querySelector('#btnAtras_equipo');
    if (btnAtrasEquipo) btnAtrasEquipo.addEventListener('click', () => show('seccion5-cliente'));
    const btnContinuarEquipo = container.querySelector('#btnContinuar_equipo');
    if (btnContinuarEquipo) btnContinuarEquipo.addEventListener('click', () => show('seccion7-diagnostico'));
    const btnAtrasDiag = container.querySelector('#btnAtras_diag');
    if (btnAtrasDiag) btnAtrasDiag.addEventListener('click', () => show('seccion6-equipo'));
    const btnContinuarDiag = container.querySelector('#btnContinuar_diag');
    if (btnContinuarDiag) btnContinuarDiag.addEventListener('click', () => show('seccion8-mantenimiento'));
    const btnAtrasMantenimiento = container.querySelector('#btnAtras_mantenimiento');
    if (btnAtrasMantenimiento) btnAtrasMantenimiento.addEventListener('click', () => show('seccion7-diagnostico'));
    const btnContinuarMantenimiento = container.querySelector('#btnContinuar_mantenimiento');
    if (btnContinuarMantenimiento && tipoMantenimiento && detalleFreezer) btnContinuarMantenimiento.addEventListener('click', () => {
        const tipo = tipoMantenimiento.value;
        if (!tipo) { alert('Seleccione tipo mantenimiento.'); return; }
        currentPath = tipo; isDescarteTaller = false;
        Array.from(detalleFreezer.options).forEach(opt => opt.disabled = false);
        if (tipo === 'YP') { show('seccion12-rep-funcional'); }
        else if (tipo === 'YA') { show('seccion10-correctivo'); }
        else if (tipo === 'YM') { show('seccion9-alistamiento'); }
    });
    const btnAtrasAlistamiento = container.querySelector('#btnAtras_alistamiento');
    if (btnAtrasAlistamiento) btnAtrasAlistamiento.addEventListener('click', () => show('seccion8-mantenimiento'));
    const btnContinuarAlistamiento = container.querySelector('#btnContinuar_alistamiento');
    if (btnContinuarAlistamiento && detalleAlistamiento && detalleFreezer) btnContinuarAlistamiento.addEventListener('click', () => {
        const detalle = detalleAlistamiento.value;
        if (!detalle) { alert('Seleccione detalle alistamiento.'); return; }
        isDescarteTaller = (detalle === 'DESCARTE TALLER');
        Array.from(detalleFreezer.options).forEach(opt => {
            if (isDescarteTaller) { opt.disabled = (opt.value !== 'NO APLICA ( N#A)'); } else { opt.disabled = false; }
        });
        if (isDescarteTaller) { detalleFreezer.value = 'NO APLICA ( N#A)'; }
        else if (detalleFreezer.value === 'NO APLICA ( N#A)') { detalleFreezer.value = ''; }
        show('seccion11-freezer');
    });
    const btnAtrasCorrectivo = container.querySelector('#btnAtras_correctivo');
    if (btnAtrasCorrectivo) btnAtrasCorrectivo.addEventListener('click', () => show('seccion8-mantenimiento'));
    const btnSiguienteCorrectivo = container.querySelector('#btnSiguiente_correctivo');
    if (btnSiguienteCorrectivo && detalleFreezer) btnSiguienteCorrectivo.addEventListener('click', () => {
        const mttoP = detalleFreezer.querySelector('option[value="MTTO PREVENTIVO"]');
        const naO = detalleFreezer.querySelector('option[value="NO APLICA ( N#A)"]');
        if (mttoP) mttoP.disabled = true; if (naO) naO.disabled = true;
        if (detalleFreezer.value === 'MTTO PREVENTIVO' || detalleFreezer.value === 'NO APLICA ( N#A)') { detalleFreezer.value = ''; }
        show('seccion11-freezer');
    });
    const btnAtrasFreezer = container.querySelector('#btnAtras_freezer');
    if (btnAtrasFreezer) btnAtrasFreezer.addEventListener('click', () => {
        if (currentPath === 'YA') show('seccion10-correctivo');
        else if (currentPath === 'YM') { if (detalleFreezer) Array.from(detalleFreezer.options).forEach(opt => opt.disabled = false); show('seccion9-alistamiento'); }
        else show('seccion8-mantenimiento');
    });
    const btnContinuarFreezer = container.querySelector('#btnContinuar_freezer');
    if (btnContinuarFreezer && detalleFreezer) btnContinuarFreezer.addEventListener('click', () => {
        const detalle = detalleFreezer.value;
        if (!detalle) { alert('Seleccione detalle mantenimiento.'); return; }
        if (isDescarteTaller) show('seccion14-descripcion'); else show('seccion12-rep-funcional');
    });
    const btnAtrasRepFuncional = container.querySelector('#btnAtras_rep_funcional');
    if (btnAtrasRepFuncional) btnAtrasRepFuncional.addEventListener('click', () => {
        if (currentPath === 'YP') show('seccion8-mantenimiento'); else show('seccion11-freezer');
    });
    const btnSiguienteSec12 = container.querySelector('#btnSiguiente_Sec12');
    if (btnSiguienteSec12) btnSiguienteSec12.addEventListener('click', () => { show('seccion13-rep-nofuncional'); });
    const btnAtrasRepNoFuncional = container.querySelector('#btnAtras_rep_nofuncional');
    if (btnAtrasRepNoFuncional) btnAtrasRepNoFuncional.addEventListener('click', () => { show('seccion12-rep-funcional'); });
    const btnContinuarSec13 = container.querySelector('#btnContinuar_Sec13');
    if (btnContinuarSec13) btnContinuarSec13.addEventListener('click', () => { show('seccion14-descripcion'); });
    const btnAtrasDescripcion = container.querySelector('#btnAtras_descripcion');
    if (btnAtrasDescripcion) btnAtrasDescripcion.addEventListener('click', () => {
        if (isDescarteTaller) show('seccion11-freezer'); else show('seccion13-rep-nofuncional');
    });
    const btnSiguienteDescripcion = container.querySelector('#btnSiguiente_descripcion');
    if (btnSiguienteDescripcion) btnSiguienteDescripcion.addEventListener('click', () => { show('seccion15-estado'); });
    const btnAtrasEstado = container.querySelector('#btnAtras_estado');
    if (btnAtrasEstado) btnAtrasEstado.addEventListener('click', () => { show('seccion14-descripcion'); });
    if (estadoReposicion && btnContinuarEstado) {
        estadoReposicion.addEventListener('change', (event) => { if (btnContinuarEstado) btnContinuarEstado.textContent = 'Siguiente ➡️'; });
        btnContinuarEstado.addEventListener('click', () => {
            const repo = estadoReposicion.value; const movEl = container.querySelector('#estadoMovilizacion');
            const mov = movEl ? movEl.value : ''; if (!mov || !repo) { alert('Seleccione ambos estados.'); return; }
            if (repo === 'SE SUGIERE REPOSICION DE PRODUCTO') { show('seccion16-inventario'); }
            else { show('seccion17-firma'); }
        });
    }


    // (Lógica de Inventario)
    const btnAtrasInventario = container.querySelector('#btnAtras_inventario');
    if (btnAtrasInventario) btnAtrasInventario.addEventListener('click', () => { show('seccion15-estado'); });
    const btnSiguienteInventario = container.querySelector('#btnSiguiente_inventario');
    if (btnSiguienteInventario) btnSiguienteInventario.addEventListener('click', () => {
        const resumenContenidoPre = container.querySelector('#resumen_inventario_contenido pre');
        if (!resumenContenidoPre) {
            console.error("Error: No se encontró #resumen_inventario_contenido pre.");
            show('seccion1admin');
            return;
        }
        let resumenTexto = "";
        let itemsAgregados = 0;
        const todasLasFilas = container.querySelectorAll('#inventory-table .inventory-row');
        todasLasFilas.forEach(row => {
            const qtyInput = row.querySelector('.cantidad-producto');
            if (!qtyInput) return;
            const cantidad = parseInt(qtyInput.value, 10) || 0;
            if (cantidad > 0) {
                const nombreEl = row.querySelector('.inventory-cell[data-label="PRODUCTO"]');
                const subtotalEl = row.querySelector('.subtotal-producto');
                if (nombreEl && subtotalEl) {
                    resumenTexto += `• ${cantidad} x ${nombreEl.textContent} (Sub: ${subtotalEl.value})\n`;
                    itemsAgregados++;
                }
            }
        });
        if (itemsAgregados === 0) { resumenTexto += "No se agregaron productos.\n"; }
        const subTotalEl = container.querySelector('#grandSubTotal');
        const itbisEl = container.querySelector('#itbisAmount');
        const totalEl = container.querySelector('#grandTotalAmount');
        resumenTexto += "\n----------------------------------\n";
        resumenTexto += `SUB-TOTAL: ${subTotalEl ? subTotalEl.textContent : formatCurrencyRD(0)}\n`;
        resumenTexto += `ITBIS (18%): ${itbisEl ? itbisEl.textContent : formatCurrencyRD(0)}\n`;
        resumenTexto += `TOTAL GENERAL: ${totalEl ? totalEl.textContent : formatCurrencyRD(0)}\n`;
        resumenContenidoPre.textContent = resumenTexto;
        show('seccion16_resumen');
    });

    // (Resumen y Firma)
    const btnAtrasResumen = container.querySelector('#btnAtras_resumen');
    if (btnAtrasResumen) btnAtrasResumen.addEventListener('click', () => { show('seccion16-inventario'); });
    const btnSiguienteResumen = container.querySelector('#btnSiguiente_resumen');
    if (btnSiguienteResumen) btnSiguienteResumen.addEventListener('click', () => { show('seccion17-firma'); });
    const btnAtrasFirma = container.querySelector('#btnAtras_firma');
    if (btnAtrasFirma && estadoReposicion) btnAtrasFirma.addEventListener('click', () => {
        const repoValue = estadoReposicion.value;
        if (repoValue === 'SE SUGIERE REPOSICION DE PRODUCTO') { show('seccion16_resumen'); }
        else { show('seccion15-estado'); }
    });

    const btnFinalizarFirma = container.querySelector('#btnFinalizar_firma');
    if (btnFinalizarFirma) btnFinalizarFirma.addEventListener('click', () => {
        if (!signaturePad || signaturePad.isEmpty()) { alert('Por favor, pida al cliente que firme antes de finalizar.'); return; }
        btnFinalizarFirma.disabled = true; btnFinalizarFirma.textContent = 'Guardando... ⏳';
        const datosFormulario = recopilarDatosFormulario();
        const datosInventario = recopilarDatosInventario();
        google.script.run
            .withSuccessHandler(onGuardadoExitoso)
            .withFailureHandler(onFalloAlGuardar)
            .guardarDatosCompletos(datosFormulario, datosInventario);
    });

    // (Buscar Cliente)
    if (btnBuscarCliente && codigoCliente) btnBuscarCliente.addEventListener('click', () => {
        const codigo = (codigoCliente.value || '').trim(); if (!codigo) { alert('Ingrese código'); return; }
        btnBuscarCliente.disabled = true; btnBuscarCliente.textContent = 'Buscando...';
        if (typeof google !== 'undefined' && google.script && google.script.run) {
            google.script.run
                .withSuccessHandler(function(datos) {
                    btnBuscarCliente.disabled = false; btnBuscarCliente.textContent = 'Buscar 🔍';
                    if (datos) {
                        const nE = container.querySelector('#nombreEstablecimiento'); if (nE) nE.value = datos.establecimiento || '';
                        const t = container.querySelector('#telefono'); if (t) t.value = datos.telefono || '';
                        const v = container.querySelector('#vendedor'); if (v) v.value = datos.vendedor || '';
                        const s = container.querySelector('#supervisor'); if (s) s.value = datos.supervisor || '';
                        const p = container.querySelector('#placaFreezer'); if (p) p.value = datos.placa || '';
                        const m = container.querySelector('#modelo'); if (m) m.value = datos.modelo || '';
                        
                        // Guardamos el correo del cliente en el localStorage para usarlo al final
                        const datosGuardados = JSON.parse(localStorage.getItem(LOCAL_STORAGE_KEY) || "{}");
                        datosGuardados.correoCliente = datos.correoCliente || "";
                        localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(datosGuardados));

                        // MEJORA: Guardar los datos del cliente buscado
                        debouncedSave();

                    } else { alert('Código no encontrado.'); }
                })
                .withFailureHandler(function(error) {
                    btnBuscarCliente.disabled = false; btnBuscarCliente.textContent = 'Buscar 🔍';
                    alert('Error al buscar cliente: ' + error.message);
                })
                .obtenerDatosCliente(codigo);
        } else {
            console.error("google.script.run no disponible."); alert("Error: No se puede conectar.");
            btnBuscarCliente.disabled = false; btnBuscarCliente.textContent = 'Buscar 🔍';
        }
    });

    // (Lógica de Inputs de Inventario)
    const cantidadInputs = container.querySelectorAll('#inventory-table .cantidad-producto');
    cantidadInputs.forEach(input => {
        // USAR 'input' para que recalcule mientras escribe
        input.addEventListener('input', (event) => {
            // Recalcular solo los totales generales
            calcularTotalesInventario();
        });
        input.addEventListener('focus', (event) => {
            const row = event.target.closest('.inventory-row');
            if (row) row.classList.add('focused');
        });
        input.addEventListener('blur', (event) => {
            const row = event.target.closest('.inventory-row');
            if (row) row.classList.remove('focused');
        });
    });


    // --- Adjuntar listeners para guardado automático ---
    const formContainer = document.getElementById('form-container');
    if (formContainer) {
        // 'input' se dispara inmediatamente para texto y números
        formContainer.addEventListener('input', (e) => {
            const target = e.target;
            if (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA') {
                // Excluir los buscadores
                if (target.id !== 'searchRepFuncional' && target.id !== 'searchRepNoFuncional' && target.id !== 'searchInventory') {
                    debouncedSave();
                }
            }
        });
        // 'change' se dispara al seleccionar en <select> o marcar/desmarcar checkbox
        formContainer.addEventListener('change', (e) => {
            const target = e.target;
            if (target.tagName === 'SELECT' || target.type === 'checkbox') {
                debouncedSave();
            }
        });
    }
} // Fin de attachHandlers

// --- PUNTO DE ENTRADA ---
renderTemplate();

// --- Listener para el botón de borrar ---
const clearBtn = document.getElementById('clear-backup-btn');
if (clearBtn) {
clearBtn.addEventListener('click', () => {
if (confirm('¿Está seguro de que desea borrar todo el progreso no enviado? Esta acción no se puede deshacer.')) {
try {
localStorage.removeItem(LOCAL_STORAGE_KEY);
updateSaveStatus('Progreso borrado');
hideSaveStatus(1500);

// Reiniciar el formulario limpiamente
renderTemplate();

} catch (e) {
console.error('Error al borrar backup:', e);
alert('No se pudo borrar el progreso guardado.');
}
}
});
} else {
console.warn('No se encontró #clear-backup-btn');
}

})();
</script>
</body>
</html>
