}
}

// Esta variable es para guardar el correo del cliente que viene de la búsqueda
// La definimos aquí para que esté en el "scope" de la función
let correoClienteObtenido = "";
// Intentamos buscar si ya existe en el formulario (aunque esté oculto)
const datosClienteExistentes = localStorage.getItem(LOCAL_STORAGE_KEY);
if (datosClienteExistentes) {
    try {
        correoClienteObtenido = JSON.parse(datosClienteExistentes).correoCliente || "";
    } catch(e) {}
}


const datos = {
tecnico: g('tecnico').value,
moto: g('moto').value,
ubicacion: g('ubicacion').value,
zona: g('zona').value,
codigoCliente: g('codigoCliente').value,
nombreEstablecimiento: g('nombreEstablecimiento').value,
telefono: g('telefono').value,
vendedor: g('vendedor').value,
supervisor: g('supervisor').value,
placaFreezer: g('placaFreezer').value,
modelo: g('modelo').value,
fotoPlacaBase64: fotoPlacaBase64, // <-- Dato de la foto
fotoPlacaMimeType: fotoPlacaMimeType, // <-- Dato de la foto
correoCliente: correoClienteObtenido, // <-- Dato del correo
diagnosticoInicial: g('diagnosticoInicial').value,
funcionamientoElectrico: g('funcionamientoElectrico').value,
nivelGas: g('nivelGas').value,
requiereReparacion: g('requiereReparacion').value,
tipoMantenimiento: g('tipoMantenimiento').value,
detalleAlistamiento: g('detalleAlistamiento').value,
detalleCorrectivo: g('detalleCorrectivo').value,
nombreAtendio: g('nombreAtendio').value,
telefonoAtendio: g('telefonoAtendio').value,
detalleFreezer: g('detalleFreezer').value,
repuestosFuncionales: repFuncionales.join(', ') || 'N/A',
repuestosNoFuncionales: repNoFuncionales.join(', ') || 'N/A',
trabajoRealizado: g('trabajoRealizado').value,
horaInicio: `${g('horaInicio_hh').value || '00'}:${g('horaInicio_mm').value || '00'}`,
horaFinal: `${g('horaFinal_hh').value || '00'}:${g('horaFinal_mm').value || '00'}`,
estadoMovilizacion: g('estadoMovilizacion').value,
estadoReposicion: g('estadoReposicion').value,
totalInventario: totalInventarioValorNumerico,
firmaBase64: (signaturePad && !signaturePad.isEmpty()) ? signaturePad.toDataURL() : 'SIN FIRMA'
};

return datos;
}

function recopilarDatosInventario() {
const container = document.getElementById('form-container');
let inventario = [];
const filas = container.querySelectorAll('#inventory-table .inventory-row');

filas.forEach(row => {
